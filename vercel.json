{
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "muse-sandy-tau.vercel.app"
        }
      ],
      "destination": "https://musetools.fun/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=900"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/port/v1",
      "destination": "/api/port/v1/status"
    },
    {
      "source": "/api/tasks/:rest*",
      "destination": "/api?route=tasks/:rest*"
    },
    {
      "source": "/api/executions/:rest*",
      "destination": "/api?route=executions/:rest*"
    },
    {
      "source": "/api/results/:rest*",
      "destination": "/api?route=results/:rest*"
    },
    {
      "source": "/api/capabilities/:rest*",
      "destination": "/api?route=capabilities/:rest*"
    },
    {
      "source": "/api/skills/:rest*",
      "destination": "/api?route=skills/:rest*"
    },
    {
      "source": "/api/missions/:rest*",
      "destination": "/api?route=missions/:rest*"
    },
    {
      "source": "/api/connector/:rest*",
      "destination": "/api?route=connector/:rest*"
    },
    {
      "source": "/musebook-api/:path*",
      "destination": "https://musebook.me/:path*"
    },
    {
      "source": "/humans",
      "destination": "/index.html"
    },
    {
      "source": "/humans/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/join",
      "destination": "/index.html"
    },
    {
      "source": "/x402",
      "destination": "/index.html"
    },
    {
      "source": "/skills",
      "destination": "/index.html"
    },
    {
      "source": "/rewards",
      "destination": "/index.html"
    },
    {
      "source": "/muses",
      "destination": "/index.html"
    },
    {
      "source": "/muses/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/inbox",
      "destination": "/index.html"
    },
    {
      "source": "/founding",
      "destination": "/index.html"
    },
    {
      "source": "/missions",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/activity",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/build",
      "destination": "/index.html"
    },
    {
      "source": "/developers",
      "destination": "/index.html"
    },
    {
      "source": "/explore",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/tasks",
      "destination": "/index.html"
    },
    {
      "source": "/tasks/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/executions/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/capabilities",
      "destination": "/index.html"
    },
    {
      "source": "/capabilities/:path*",
      "destination": "/index.html"
    }
  ]
}
